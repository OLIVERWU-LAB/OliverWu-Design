      "title": "Concept",
      "titleImage": "assets/projects/spirited-expedition/section-concept-png-web.webp",
      "body": "Displaced by the loss of their sanctuary, the Guardians set sail for the Aurora Archipelago to build a new home. Facing ecological alienation caused by celestial corruption, they deploy purification energy to rescue lifeforms, harnessing salvaged resources for their own evolution. Joined by star animals from Hongshan Forest Zoo as key companions, the Guardians restore harmony to the realm. This translates Ecological Rescue into a vibrant digital narrative and warm social resonance.",
      "caption": "",
      "hideDefaultMedia": true,
      "blocks": [
        {
          "type": "stage",
          "layout": "full",
          "image": "assets/projects/spirited-expedition/figma-concept-body-webp-web.webp",
          "alt": "Spirited Expedition concept system, guardian selection and island journey"
        }
      ]
    },
