          "perspectiveTitle": "Perspective & Motion Calibration",
          "perspectiveImage": "assets/projects/spirited-expedition/technical-perspective-motion-png-web.webp",
          "specTitle": "Technical Specification",
          "specifications": [
            {
              "label": "30° Isometric Perspective",
              "text": "Compared to standard orthographic views, the 30° isometric perspective offers greater vertical coverage, causing Y-axis displacements to appear slower on-screen."
            },
            {
              "label": "Motion Compensation",
              "text": "To ensure a consistent movement experience across both axes, Y-axis velocity compensation is required."
            }
          ],
          "formula": "Vy(adj) = Vx × sin(30°)",
          "formulaNotes": [
            "Vx: Character velocity on the X-axis (World Space).",
            "Vy: Adjusted Y-axis velocity (World Space)."
          ],
